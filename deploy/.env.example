# Domain whose DNS A record points at this server. Caddy gets a certificate for it automatically.
TGN_DOMAIN=api.example.com

TGN_DB_PASSWORD=change-me-to-a-long-random-string
# Encrypts ID numbers at rest. Generate once with:  openssl rand -base64 32   and NEVER lose it (data is unreadable without it).
TGN_PII_KEY=

# The first staff account, created only if no staff exist yet.
TGN_BOOTSTRAP_ADMIN_EMAIL=you@example.com
TGN_BOOTSTRAP_ADMIN_PASSWORD=at-least-12-characters

# Where the admin dashboard is hosted (comma separated). The phone apps don't need CORS.
TGN_CORS_ALLOWED_ORIGINS=https://admin.example.com

# true loads PLACEHOLDER cover rules and a sample herd, but only into an EMPTY database. A real server needs it for its very first start,
# then you edit every number in the admin (Cover & Pricing). SMS 'log' makes codes appear in `docker compose logs backend` (demo only);
# a real server leaves SMS as 'disabled' until a provider is connected.
TGN_SEED_SAMPLE_COVER=false
TGN_SMS_MODE=disabled
